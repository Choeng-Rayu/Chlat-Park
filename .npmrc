# pnpm 11 reads every NON-registry setting from `pnpm-workspace.yaml`, not from
# this file. Only registry and auth plumbing belongs here.
#
# `overrides`, `catalog`, `allowBuilds`, `minimumReleaseAge` and the
# workspace-linking flags are all configured in `pnpm-workspace.yaml`.

# The npm registry. Kept here so the registry choice is visible in one place.
registry=https://registry.npmjs.org/

# Never install a package whose `engines.node` is unsatisfied, even with a
# warning. The monorepo requires Node >= 22.12.
engine-strict=true
