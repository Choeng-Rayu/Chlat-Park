# =============================================================================
# Chlat-Park — environment template
#
# Copy to `.env` (root) for local development:
#   cp .env.example .env
#
# `.env` is gitignored. NEVER commit a real value of any secret below.
# Every secret in this file is also asserted by the `hygiene` CI job.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared / runtime
# -----------------------------------------------------------------------------

# Node runtime mode. `production` | `development` | `test`.
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (PostgreSQL 18)
# -----------------------------------------------------------------------------

# Pooled/runtime connection string used by the application.
# The local docker-compose database matches this default.
DATABASE_URL="postgresql://chlat:chlat@localhost:5432/chlat_park?schema=public"

# Direct (un-pooled) connection string used by migrations and the Prisma
# Migrate engine. Point it at the same database but bypassing any pooler.
DIRECT_DATABASE_URL="postgresql://chlat:chlat@localhost:5432/chlat_park?schema=public"

# -----------------------------------------------------------------------------
# Authentication — JSON Web Tokens
# -----------------------------------------------------------------------------

# HMAC secret for the short-lived access token.
# Generate with:  openssl rand -base64 48
# MUST be at least 32 random bytes. Rotating it invalidates all access tokens.
JWT_ACCESS_SECRET="replace-me-with-openssl-rand-base64-48"

# HMAC secret for the rotating refresh token. MUST differ from the access
# secret. Rotating it revokes every outstanding refresh token family.
JWT_REFRESH_SECRET="replace-me-with-a-different-openssl-rand-base64-48"

# Access-token lifetime (minutes, or a duration string such as `15m`).
# The server enforces the role maximum: guard 12h, owner 8h, super admin 4h.
JWT_ACCESS_TTL=15m

# Refresh-token lifetime (minutes, or a duration string such as `7d`).
JWT_REFRESH_TTL=7d

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------

# HMAC pepper for the plate digest (`plate_digest`). Lets the same plate be
# correlated across rows without ever storing the plate in cleartext.
# Generate with:  openssl rand -hex 32
# Rotating it makes existing digests unmatchable — plan a backfill.
PLATE_PEPPER="replace-me-with-openssl-rand-hex-32"

# Symmetric key for encrypting secrets at rest (Telegram tokens, payout
# references, anything that must be decrypted, not just hashed).
# Generate with:  openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-openssl-rand-base64-32"

# -----------------------------------------------------------------------------
# API service (apps/api)
# -----------------------------------------------------------------------------

# Port the NestJS API listens on.
API_PORT=3001

# Base URL the API reaches itself on (used for absolute links in emails and
# the Scalar API reference). In docker-compose this is the service name.
API_URL="http://localhost:3001"

# Comma-separated list of browser origins allowed to call the API.
# `*` is rejected outside development.
CORS_ORIGINS="http://localhost:3000"

# Global rate-limit bucket: window length in milliseconds and max requests.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120

# Stricter bucket applied to the login endpoint (per IP and per email).
RATE_LIMIT_LOGIN_TTL_MS=900000
RATE_LIMIT_LOGIN_LIMIT=10

# -----------------------------------------------------------------------------
# Web service (apps/web)
# -----------------------------------------------------------------------------

# Public base URL of the API, as seen from the browser.
# NEXT_PUBLIC_* is baked into the client bundle — never put a secret here.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Internal base URL used for server-side rendering calls. In docker-compose
# this is `http://api:3001`; locally it is the same as NEXT_PUBLIC_API_URL.
API_INTERNAL_URL="http://localhost:3001"

# Public site URL, used for canonical links and QR deep links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Telegram integration (P1 — optional)
# -----------------------------------------------------------------------------

# Bot token issued by @BotFather. Leave empty to disable the Telegram module.
TELEGRAM_BOT_TOKEN=

# Secret token Telegram sends in the `X-Telegram-Bot-Api-Secret-Token` header.
# Requests without a matching value are rejected. Leave empty to disable.
TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Seeding (development only)
# -----------------------------------------------------------------------------

# The seed script creates the first super admin when BOTH of these are set.
# The password must be at least 12 characters. It is hashed with Argon2id and
# is never logged. Leave empty in production — the seed script then creates
# no account at all.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

