{
  "name": "@chlat/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed HTTP client for the Chlat-Park API, generated from the OpenAPI document",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/schema.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "generate": "node scripts/generate.mjs"
  },
  "dependencies": {
    "openapi-fetch": "catalog:"
  },
  "devDependencies": {
    "@chlat/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "openapi-typescript": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
