# The web app's environment.
#
# The root `.env.example` documents every variable the whole stack needs.
# This file only lists the ones the web app reads, so a developer working
# inside `apps/web` sees the relevant subset.
#
# `NEXT_PUBLIC_*` variables are inlined into the client bundle at build time.
# NEVER put a secret, token, key or pepper behind that prefix.

# Public base URL of the API, as seen from the browser.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Internal base URL used for server-side rendering calls.
# In docker-compose this is `http://api:3001`.
API_INTERNAL_URL="http://localhost:3001"

# Public site URL, used for canonical links and QR deep links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The Telegram bot username for deep links (P1 — optional).
NEXT_PUBLIC_TELEGRAM_BOT=
