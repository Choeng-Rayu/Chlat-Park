{
  "name": "@chlat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chlat-Park API — the NestJS REST API",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "pnpm run db:generate",
    "build": "node scripts/guards.mjs build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "pretypecheck": "pnpm run db:generate",
    "typecheck": "node scripts/guards.mjs typecheck",
    "pretest": "pnpm run db:generate",
    "test": "vitest run && vitest run --config vitest.e2e.config.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@chlat/contracts": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/passport": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@scalar/nestjs-api-reference": "catalog:",
    "argon2": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "passport": "catalog:",
    "passport-jwt": "catalog:",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chlat/config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "11.0.9",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "catalog:",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  }
}
